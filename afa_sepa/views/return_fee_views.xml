<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afa_sepa_return_fee_list" model="ir.ui.view">
        <field name="name">afa.sepa.return.fee.list</field>
        <field name="model">afa.sepa.return.fee</field>
        <field name="arch" type="xml">
            <list
                create="0"
                edit="0"
                delete="0"
                decoration-warning="state == 'pending'"
                decoration-success="state == 'invoiced'"
                decoration-danger="state == 'cancelled'"
            >
                <field name="returned_date"/>
                <field name="family_id"/>
                <field name="partner_id"/>
                <field name="invoice_id" string="Returned Invoice"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state"/>
                <field name="invoice_line_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_afa_sepa_return_fee_form" model="ir.ui.view">
        <field name="name">afa.sepa.return.fee.form</field>
        <field name="model">afa.sepa.return.fee</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <header>
                    <button
                        name="action_cancel"
                        string="Cancel Fee"
                        type="object"
                        class="btn-secondary"
                        confirm="This fee will no longer be added to a future invoice. Continue?"
                        invisible="state != 'pending'"
                        groups="account.group_account_manager"
                    />
                    <button
                        name="action_set_pending"
                        string="Set Pending Again"
                        type="object"
                        class="btn-secondary"
                        invisible="state != 'cancelled'"
                        groups="account.group_account_manager"
                    />
                    <field name="state" widget="statusbar" readonly="1" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="returned_date"/>
                            <field name="amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="family_id"/>
                            <field name="partner_id"/>
                            <field name="payment_line_id"/>
                            <field name="invoice_id" string="Returned Invoice"/>
                            <field name="invoice_line_id" string="Fee Invoice Line"/>
                            <field name="cancel_date" invisible="not cancel_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_afa_sepa_return_fee_search" model="ir.ui.view">
        <field name="name">afa.sepa.return.fee.search</field>
        <field name="model">afa.sepa.return.fee</field>
        <field name="arch" type="xml">
            <search>
                <field name="family_id"/>
                <field name="partner_id"/>
                <field name="invoice_id"/>
                <filter
                    name="filter_pending"
                    string="Pending"
                    domain="[('state', '=', 'pending')]"
                />
                <filter
                    name="filter_invoiced"
                    string="Invoiced"
                    domain="[('state', '=', 'invoiced')]"
                />
                <filter
                    name="filter_cancelled"
                    string="Cancelled"
                    domain="[('state', '=', 'cancelled')]"
                />
                <separator/>
                <filter name="returned_date" string="Returned Date" date="returned_date"/>
                <group>
                    <filter
                        name="group_by_state"
                        string="Status"
                        context="{'group_by': 'state'}"
                    />
                    <filter
                        name="group_by_family"
                        string="Family"
                        context="{'group_by': 'family_id'}"
                    />
                    <filter
                        name="group_by_returned_date"
                        string="Returned Date"
                        context="{'group_by': 'returned_date'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_afa_sepa_return_fee" model="ir.actions.act_window">
        <field name="name">SEPA Return Fees</field>
        <field name="res_model">afa.sepa.return.fee</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_afa_sepa_return_fee_search"/>
        <field name="context">{'search_default_filter_pending': 1}</field>
    </record>

    <menuitem
        id="menu_afa_sepa_return_fee"
        name="SEPA Return Fees"
        parent="account.menu_finance_receivables"
        action="action_afa_sepa_return_fee"
        sequence="25"
        groups="account.group_account_manager"
    />
</odoo>
