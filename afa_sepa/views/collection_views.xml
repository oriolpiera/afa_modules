<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afa_sepa_invoice_form" model="ir.ui.view">
        <field name="name">afa.sepa.invoice.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_afa_sepa_lines" type="object"
                        class="oe_stat_button" icon="fa-file-text-o" string="AFA Debits"
                        groups="afa_family.group_family_manager" invisible="move_type != 'out_invoice'"/>
            </xpath>
        </field>
    </record>
    <record id="view_afa_sepa_family_form" model="ir.ui.view">
        <field name="name">afa.sepa.family.form</field>
        <field name="model">afa.family</field>
        <field name="inherit_id" ref="afa_family.view_afa_family_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_afa_sepa_lines" type="object"
                        class="oe_stat_button" icon="fa-file-text-o" string="AFA Debits"
                        groups="account_payment_order.group_account_payment"/>
            </xpath>
        </field>
    </record>
    <record id="view_afa_sepa_order_form" model="ir.ui.view">
        <field name="name">afa.sepa.order.form</field>
        <field name="model">account.payment.order</field>
        <field name="inherit_id" ref="account_payment_order.account_payment_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_line_ids']" position="attributes">
                <attribute name="context">{'list_view_ref': 'afa_sepa.view_afa_sepa_line_list'}</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_afa_sepa_line_list" model="ir.ui.view">
        <field name="name">afa.sepa.line.list</field>
        <field name="model">account.payment.line</field>
        <field name="inherit_id" ref="account_payment_order.account_payment_line_tree"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_bank_id']" position="replace"/>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="afa_family_id" readonly="1" optional="show"/>
                <field name="move_line_id" optional="show"/>
                <field name="mandate_id" groups="account.group_account_manager" optional="show"/>
                <field name="afa_returned" readonly="1" optional="show"/>
                <button name="action_record_return" type="object" string="Record Return"
                        groups="account.group_account_manager"
                        invisible="not afa_family_id or state != 'uploaded' or afa_returned"/>
                <field name="state" column_invisible="1"/>
            </xpath>
        </field>
    </record>
    <record id="view_afa_sepa_hide_bank_list" model="ir.ui.view">
        <field name="name">afa.sepa.hide.bank.list</field>
        <field name="model">account.payment.line</field>
        <field name="inherit_id" ref="account_payment_order.account_payment_line_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_afa_sepa_line_form" model="ir.ui.view">
        <field name="name">afa.sepa.line.form</field>
        <field name="model">account.payment.line</field>
        <field name="inherit_id" ref="account_payment_order.account_payment_line_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                <attribute name="groups">account.group_account_manager</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="afa_family_id" readonly="1"/>
                <field name="mandate_id" groups="account.group_account_manager"/>
                <field name="afa_returned" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
