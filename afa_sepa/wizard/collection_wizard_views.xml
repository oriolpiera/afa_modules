<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afa_sepa_wizard_form" model="ir.ui.view">
        <field name="name">afa.sepa.wizard.form</field>
        <field name="model">afa.sepa.wizard</field>
        <field name="arch" type="xml">
            <form string="Prepare SEPA Collections">
                <group>
                    <field name="company_id" groups="base.group_multi_company"/>
                    <field name="payment_mode_id"/>
                    <field name="journal_id"/>
                    <field name="invoice_ids" widget="many2many_tags"
                           domain="[('move_type', '=', 'out_invoice'), ('state', '=', 'posted')]"/>
                </group>
                <field name="line_ids" nolabel="1">
                    <list create="0" edit="0" delete="0">
                        <field name="invoice_id"/>
                        <field name="eligible"/>
                        <field name="reason"/>
                    </list>
                </field>
                <footer>
                    <button name="action_preview" type="object" string="Check Eligibility"/>
                    <button name="action_prepare" type="object" string="Create Debit Order"
                            class="btn-primary"/>
                    <button string="Close" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_afa_sepa_wizard" model="ir.actions.act_window">
        <field name="name">Prepare SEPA Collections</field>
        <field name="res_model">afa.sepa.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="action_afa_sepa_from_invoices" model="ir.actions.act_window">
        <field name="name">Prepare AFA Direct Debit</field>
        <field name="res_model">afa.sepa.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>
    <menuitem id="menu_afa_sepa_wizard" name="Prepare SEPA Collections"
              parent="afa_family.menu_afa_family_root" action="action_afa_sepa_wizard"
              groups="afa_family.group_family_manager"/>
</odoo>
