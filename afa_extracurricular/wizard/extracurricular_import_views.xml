<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afa_extracurricular_import_wizard_form" model="ir.ui.view">
        <field name="name">afa.extracurricular.import.wizard.form</field>
        <field name="model">afa.extracurricular.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Extracurricular Enrollments">
                <sheet>
                    <group>
                        <field name="file" filename="filename"/>
                        <field name="filename" invisible="1"/>
                    </group>
                    <p class="text-muted">
                        Required CSV columns: curs, nen, extraescolar, grup. The optional
                        telefon column is shown for review. Match group by its configured name.
                    </p>
                    <field name="line_ids" readonly="1">
                        <list create="0" edit="0" delete="0"
                              decoration-danger="action == 'error'"
                              decoration-muted="action == 'skip'">
                            <field name="sequence" column_invisible="1"/>
                            <field name="course"/>
                            <field name="student_name" string="Student"/>
                            <field name="phone"/>
                            <field name="activity_name" string="Activity"/>
                            <field name="group_name" string="Group"/>
                            <field name="student_id" optional="hide"/>
                            <field name="action"/>
                            <field name="error" optional="show"/>
                        </list>
                    </field>
                </sheet>
                <footer>
                    <button name="action_load" type="object" string="Preview CSV"
                            class="btn-secondary"/>
                    <button name="action_confirm" type="object" string="Confirm Import"
                            class="btn-primary" invisible="not line_ids"
                            confirm="Create the extracurricular enrollments shown below?"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_afa_extracurricular_import" model="ir.actions.act_window">
        <field name="name">Import Extracurricular Enrollments</field>
        <field name="res_model">afa.extracurricular.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_afa_extracurricular_import" name="Import Enrollments"
              parent="afa_family.menu_afa_family_root"
              action="action_afa_extracurricular_import"
              groups="afa_family.group_family_manager" sequence="21"/>
</odoo>
