<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afa_family_member_add_wizard_form" model="ir.ui.view">
        <field name="name">afa.family.member.add.wizard.form</field>
        <field name="model">afa.family.member.add.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Existing Contacts">
                <group>
                    <field name="family_id" invisible="1"/>
                    <field name="role" invisible="1"/>
                    <field name="partner_ids" widget="many2many_tags"
                           options="{'no_create': True, 'no_create_edit': True}"/>
                </group>
                <footer>
                    <button name="action_add_members" type="object" string="Add"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
