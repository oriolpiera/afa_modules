<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_afa_family" model="ir.ui.view">
        <field name="name">res.partner.form.afa.family</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group" position="inside">
                <group string="AFA Family" groups="afa_family.group_family_manager">
                    <field name="afa_family_role"/>
                    <field name="afa_family_id"/>
                    <field name="afa_is_billing_guardian"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_partner_list_afa_family" model="ir.ui.view">
        <field name="name">res.partner.list.afa.family</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='display_name']" position="after">
                <field name="afa_family_role" optional="show"
                       groups="afa_family.group_family_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
