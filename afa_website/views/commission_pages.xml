    <record id="page_junta" model="website.page">
        <field name="name">Junta</field>
        <field name="is_published" eval="True" />
        <field name="key">afa_website.page_junta</field>
        <field name="url">/junta</field>
        <field name="website_id" ref="website.default_website" />
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="afa_website.page_junta">
                <t t-call="website.layout">
                    <t t-set="additional_title">La Junta · AFA Escola La Bòbila</t>
                    <div id="wrap" class="oe_structure afa-homepage afa-commission-page">
                        <section class="afa-commission-hero">
                            <img src="/afa_website/static/src/img/school-front.jpg" alt="Entrada de l’Escola La Bòbila" />
                            <div class="container afa-commission-hero__content">
                                <p class="afa-eyebrow">Les persones al darrere</p>
                                <h1>La Junta</h1>
                                <p>Coordina les iniciatives de l’AFA i fa de canal entre l’escola i les famílies.</p>
                            </div>
                        </section>
                        <section class="afa-commission-body">
                            <div class="container afa-commission-body__grid">
                                <p class="afa-eyebrow afa-eyebrow--green">Què fa la Junta</p>
                                <div>
                                    <h2>Connectem idees i persones.</h2>
                                    <p>La Junta representa les famílies i ajuda a coordinar els projectes i les comissions de l’AFA. Treballa perquè la comunicació amb l’escola sigui fluida i perquè les necessitats de les famílies tinguin un espai compartit.</p>
                                    <p>La participació és oberta: les reunions mensuals són una bona manera de conèixer què s’està fent i aportar noves idees.</p>
                                    <a class="afa-inline-link" href="/contactus">Vine a una reunió <span aria-hidden="true">→</span></a>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="page_acollida" model="website.page">
        <field name="name">Acollida</field>
        <field name="is_published" eval="True" />
        <field name="key">afa_website.page_acollida</field>
        <field name="url">/acollida</field>
        <field name="website_id" ref="website.default_website" />
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="afa_website.page_acollida">
                <t t-call="website.layout">
                    <t t-set="additional_title">Acollida · AFA Escola La Bòbila</t>
                    <div id="wrap" class="oe_structure afa-homepage afa-commission-page">
                        <section class="afa-commission-hero">
                            <img src="/afa_website/static/src/img/school-garden.jpg" alt="Espais verds de l’Escola La Bòbila" />
                            <div class="container afa-commission-hero__content">
                                <p class="afa-eyebrow">Un espai abans i després de classe</p>
                                <h1>Acollida</h1>
                                <p>Acompanyem els infants en horaris no lectius i ajudem les famílies a conciliar el dia a dia.</p>
                            </div>
                        </section>
                        <section class="afa-commission-body">
                            <div class="container afa-commission-body__grid">
                                <p class="afa-eyebrow afa-eyebrow--green">El servei</p>
                                <div>
                                    <h2>Temps per jugar, llegir i compartir.</h2>
                                    <p>L’acollida ofereix un entorn tranquil i acompanyat abans i després de l’horari lectiu. Segons el moment del dia, els infants poden esmorzar o berenar, jugar, llegir, fer jocs de taula i avançar deures.</p>
                                    <p>Per conèixer els horaris, les places disponibles i com inscriure-us, contacteu amb la comissió.</p>
                                    <a class="afa-inline-link" href="mailto:acollida@afabobila.cat">Escriu a acollida@afabobila.cat <span aria-hidden="true">↗</span></a>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="page_menjador" model="website.page">
