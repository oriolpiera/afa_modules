        <field name="key">afa_website.page_menjador</field>
        <field name="url">/menjador</field>
        <field name="website_id" ref="website.default_website" />
        <field name="type">qweb</field>
        <field name="arch" type="xml">
            <t t-name="afa_website.page_menjador">
                <t t-call="website.layout">
                    <t t-set="additional_title">Menjador · AFA Escola La Bòbila</t>
                    <div id="wrap" class="oe_structure afa-homepage afa-commission-page">
                        <section class="afa-commission-hero">
                            <img src="/afa_website/static/src/img/school-courtyard.jpg" alt="Pati de l’Escola La Bòbila" />
                            <div class="container afa-commission-hero__content">
                                <p class="afa-eyebrow">Un espai per créixer plegats</p>
                                <h1>Menjador</h1>
                                <p>Fem seguiment del servei i treballem perquè l’estona de migdia sigui una part cuidada del dia a l’escola.</p>
                            </div>
                        </section>
                        <section class="afa-commission-body">
                            <div class="container afa-commission-body__grid">
                                <p class="afa-eyebrow afa-eyebrow--green">La comissió</p>
                                <div>
                                    <h2>Coordinació i qualitat del servei.</h2>
                                    <p>La comissió es coordina amb l’escola i amb l’empresa responsable del menjador per fer seguiment del servei i canalitzar les preguntes i propostes de les famílies.</p>
                                    <p>Per consultar la informació vigent sobre menús, inscripcions i funcionament, contacteu amb la comissió.</p>
                                    <a class="afa-inline-link" href="mailto:menjador@afabobila.cat">Escriu a menjador@afabobila.cat <span aria-hidden="true">↗</span></a>
                                </div>
                            </div>
                        </section>
                    </div>
                </t>
            </t>
        </field>
    </record>

