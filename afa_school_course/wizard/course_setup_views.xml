<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afa_school_course_setup_wizard_form" model="ir.ui.view">
        <field name="name">afa.school.course.setup.wizard.form</field>
        <field name="model">afa.school.course.setup.wizard</field>
        <field name="arch" type="xml">
            <form string="Quick Course Setup">
                <sheet>
                    <group>
                        <field name="infantil"/>
                        <field name="primaria"/>
                        <field name="secundaria"/>
                    </group>
                    <p class="text-muted">
                        Creates the missing courses, orders them and links each course to its
                        successor. The last course of the last selected stage is left without a
                        successor, which means graduation; a successor that is already configured
                        is kept. Existing courses are never modified: only missing courses and
                        empty successors are filled in, and the whole set must remain one
                        connected ladder.
                    </p>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Create Courses"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_afa_school_course_setup_wizard" model="ir.actions.act_window">
        <field name="name">Quick Course Setup</field>
        <field name="res_model">afa.school.course.setup.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_afa_school_course_setup_wizard" name="Quick Course Setup"
              parent="afa_family.menu_afa_family_root" action="action_afa_school_course_setup_wizard"
              groups="afa_family.group_family_manager"/>
</odoo>
