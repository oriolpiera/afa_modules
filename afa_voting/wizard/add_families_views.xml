<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_add_families_wizard_form" model="ir.ui.view">
        <field name="name">afa.voting.add.families.wizard.form</field>
        <field name="model">afa.voting.add.families.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Families to a Voting">
                <group>
                    <field name="family_ids" widget="many2many_tags" readonly="1"/>
                    <field name="voting_id" required="1" options="{'no_create': True}"/>
                </group>
                <footer>
                    <button name="action_add_families" type="object" string="Add to Voting" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
