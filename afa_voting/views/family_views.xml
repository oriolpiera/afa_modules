<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afa_family_list_add_to_voting" model="ir.ui.view">
        <field name="name">afa.family.list.add.to.voting</field>
        <field name="model">afa.family</field>
        <field name="inherit_id" ref="afa_family.view_afa_family_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <button name="action_add_to_voting" type="object" string="Add to Voting" icon="fa-plus" groups="afa_voting.group_voting_manager"/>
            </xpath>
        </field>
    </record>
</odoo>
