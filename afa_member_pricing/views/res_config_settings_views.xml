<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_afa_pricing" model="ir.ui.view">
        <field name="name">res.config.settings.afa.pricing</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AFA Pricing" name="afa_pricing">
                    <block title="Family Pricelists">
                        <setting string="Member pricelist">
                            <field name="afa_member_pricelist_id"/>
                        </setting>
                        <setting string="Non-member pricelist">
                            <field name="afa_nonmember_pricelist_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
