<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_membership_application_list" model="ir.ui.view">
        <field name="name">afa.membership.application.list</field>
        <field name="model">afa.membership.application</field>
        <field name="arch" type="xml">
            <list decoration-info="state == 'pending'"
                  decoration-success="state == 'approved'"
                  decoration-muted="state == 'rejected'">
                <field name="create_date" string="Submitted"/>
                <field name="guardian1_name" string="Main Guardian"/>
                <field name="guardian1_email" string="Contact Email"/>
                <field name="guardian1_phone" string="Contact Phone" optional="hide"/>
                <field name="wants_membership"/>
                <field name="state"/>
                <field name="family_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_membership_application_form" model="ir.ui.view">
        <field name="name">afa.membership.application.form</field>
        <field name="model">afa.membership.application</field>
        <field name="arch" type="xml">
            <form create="false" delete="false">
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'pending'"
                            groups="afa_family.group_family_manager"
                            confirm="Approving this request creates the family, contacts and SEPA mandate when selected."/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'pending'"
                            groups="afa_family.group_family_manager"
                            confirm="Reject this membership application?"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(afa_family.action_afa_family)d" type="action"
                                class="oe_stat_button" icon="fa-users"
                                invisible="not family_id">
                            <field name="family_id" widget="statinfo" string="Family"/>
                        </button>
                    </div>
                    <group>
                        <group string="Application">
                            <field name="name" readonly="1"/>
                            <field name="family_name" readonly="state != 'pending'"/>
                            <field name="create_date" readonly="1"/>
                            <field name="address" readonly="state != 'pending'"/>
                        </group>
                        <group string="Membership and payment">
                            <field name="wants_membership" readonly="state != 'pending'"/>
                            <field name="bank_account_holder_name" readonly="1" invisible="not wants_membership"/>
                            <field name="iban" readonly="1" invisible="not wants_membership"/>
                            <field name="mandate_accepted" readonly="1" invisible="not wants_membership"/>
                            <field name="mandate_accepted_at" readonly="1" invisible="not wants_membership"/>
                            <field name="mandate_terms_version" readonly="1" invisible="not wants_membership"/>
                            <field name="rejection_reason" readonly="state != 'pending'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Guardians">
                            <group>
                                <group string="First guardian">
                                    <field name="guardian1_name" readonly="state != 'pending'"/>
                                    <field name="guardian1_vat" readonly="state != 'pending'"/>
                                    <field name="guardian1_email" readonly="state != 'pending'"/>
                                    <field name="guardian1_phone" readonly="state != 'pending'"/>
                                </group>
                                <group string="Second guardian">
                                    <field name="guardian2_name" readonly="state != 'pending'"/>
                                    <field name="guardian2_vat" readonly="state != 'pending'"/>
                                    <field name="guardian2_email" readonly="state != 'pending'"/>
                                    <field name="guardian2_phone" readonly="state != 'pending'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Students">
                            <field name="student_ids" readonly="state != 'pending'">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="name"/>
                                    <field name="birthday"/>
                                    <field name="course_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group string="Review" invisible="not reviewed_at">
                        <field name="reviewed_by_id" readonly="1"/>
                        <field name="reviewed_at" readonly="1"/>
                        <field name="family_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_membership_applications" model="ir.actions.act_window">
        <field name="name">Membership Applications</field>
        <field name="res_model">afa.membership.application</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>

    <record id="view_membership_application_search" model="ir.ui.view">
        <field name="name">afa.membership.application.search</field>
        <field name="model">afa.membership.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="guardian1_name"/>
                <field name="guardian1_email"/>
                <filter name="pending" string="Pending Review" domain="[('state', '=', 'pending')]"/>
                <filter name="approved" string="Approved" domain="[('state', '=', 'approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('state', '=', 'rejected')]"/>
            </search>
        </field>
    </record>

    <menuitem id="menu_membership_applications" name="Membership Applications"
              parent="afa_family.menu_afa_family_root"
              action="action_membership_applications"
              groups="afa_family.group_family_manager" sequence="20"/>
</odoo>
