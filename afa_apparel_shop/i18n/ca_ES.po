#: model:ir.actions.server,name:afa_apparel_shop.ir_cron_cancel_expired_web_stock_reservations_ir_actions_server
msgid "Cancel expired AFA web orders"
msgstr "Cancel·la les comandes web caducades de l'AFA"

#. module: afa_apparel_shop
#: model:ir.model.fields,field_description:afa_apparel_shop.field_payment_transaction__display_name
#: model:ir.model.fields,field_description:afa_apparel_shop.field_sale_order__display_name
