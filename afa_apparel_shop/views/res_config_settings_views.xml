<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_afa_apparel" model="ir.ui.view">
        <field name="name">res.config.settings.afa.apparel</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AFA Apparel Shop" name="afa_apparel_shop">
                    <block title="Order Notifications">
                        <setting
                            string="Paid order email"
                            company_dependent="1"
                            help="Internal address that receives each paid webshop order so the team can prepare the delivery. Leave empty to disable."
                        >
                            <field name="afa_paid_order_email" placeholder="botiga@afabobila.cat"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
