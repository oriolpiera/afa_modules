<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="delivery_method" inherit_id="website_sale.delivery_method"
              name="AFA School Pickup Delivery Method">
        <xpath expr="//input[@name='o_delivery_radio']" position="attributes">
            <attribute name="t-att-data-afa-school-pickup">dm.afa_school_pickup and 'true' or 'false'</attribute>
        </xpath>
    </template>

    <template id="delivery_address_list" inherit_id="website_sale.delivery_address_list"
              name="AFA School Pickup Hides Delivery Address">
        <xpath expr="//div[@id='delivery_address_list']" position="attributes">
            <attribute name="t-attf-class">{{ 'd-none' if order.carrier_id.afa_school_pickup else '' }}</attribute>
        </xpath>
    </template>

    <!-- Core renders the cart coupon field whenever the caller leaves
         `hide_promotions` falsy, even when the "Discounts, Loyalty & Gift
         Card" setting is off. Force the flag when promotions are disabled so
         families are not invited to enter discount codes that cannot work. -->
    <template id="cart_total_hide_promotions" inherit_id="website_sale.total"
              name="AFA Hide Cart Coupon Field When Discounts Are Disabled">
        <xpath expr="//div[contains(@t-attf-class, 'o_cart_total')]" position="before">
            <t t-set="hide_promotions" t-value="hide_promotions or not website.is_promotions_enabled()"/>
        </xpath>
    </template>

</odoo>
