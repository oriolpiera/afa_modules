<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_afa_membership_period_list" model="ir.ui.view">
        <field name="name">afa.membership.period.list</field>
        <field name="model">afa.membership.period</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="date_start"/><field name="date_end"/></list>
        </field>
    </record>
    <record id="view_afa_membership_period_form" model="ir.ui.view">
        <field name="name">afa.membership.period.form</field>
        <field name="model">afa.membership.period</field>
        <field name="arch" type="xml">
            <form><sheet><group><field name="name"/><field name="date_start"/><field name="date_end"/></group></sheet></form>
        </field>
    </record>
    <record id="view_afa_membership_list" model="ir.ui.view">
        <field name="name">afa.membership.list</field>
        <field name="model">afa.membership</field>
        <field name="arch" type="xml">
            <list><field name="family_id"/><field name="period_id"/><field name="active"/>
                <field name="date_start"/><field name="date_end"/>
                <field name="state"/><field name="invoice_id"/></list>
        </field>
    </record>
    <record id="view_afa_membership_form" model="ir.ui.view">
        <field name="name">afa.membership.form</field>
        <field name="model">afa.membership</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="family_id"/>
                        <field name="period_id"/>
                        <field name="active"/>
                        <field name="date_start" readonly="1"/>
                        <field name="date_end" readonly="1"/>
                        <field name="state" readonly="1"/>
                        <field name="dues_product_id"
                               invisible="invoice_id and invoice_state != 'cancel'"/>
                        <field name="invoice_id" readonly="1"/>
                        <field name="invoice_state" invisible="1"/>
                    </group>
                    <button name="action_create_dues_invoice" type="object"
                            string="Create Dues Invoice" class="btn-primary"
                            invisible="not active or (invoice_id and invoice_state != 'cancel') or not dues_product_id"/>
                    <button name="action_open_dues_invoice" type="object"
                            string="Open Dues Invoice" invisible="not invoice_id"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_afa_membership_period" model="ir.actions.act_window">
        <field name="name">School Years</field>
        <field name="res_model">afa.membership.period</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_afa_membership" model="ir.actions.act_window">
        <field name="name">Family Period Links</field>
        <field name="res_model">afa.membership</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <record id="view_afa_family_membership_form" model="ir.ui.view">
        <field name="name">afa.family.membership.form</field>
        <field name="model">afa.family</field>
        <field name="inherit_id" ref="afa_family.view_afa_family_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[1]" position="after">
                <group string="Membership" groups="afa_family.group_family_manager">
                    <field name="is_member" readonly="1"/>
                    <field name="membership_state" readonly="1"/>
                    <field name="manual_member"/>
                    <field name="current_period_id" readonly="1"/>
                    <field name="current_dues_invoice_reference" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
    <record id="view_afa_family_membership_list" model="ir.ui.view">
        <field name="name">afa.family.membership.list</field>
        <field name="model">afa.family</field>
        <field name="inherit_id" ref="afa_family.view_afa_family_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='billing_partner_id']" position="after">
                <field name="manual_member" optional="show"
                       groups="afa_family.group_family_manager"/>
                <field name="is_member" optional="hide"
                       groups="afa_family.group_family_manager"/>
            </xpath>
        </field>
    </record>
    <record id="view_afa_family_membership_search" model="ir.ui.view">
        <field name="name">afa.family.membership.search</field>
        <field name="model">afa.family</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="billing_partner_id"/>
                <filter name="membership_intent" string="Intends to Be a Member"
                        domain="[('manual_member', '=', True)]"/>
            </search>
        </field>
    </record>
    <record id="afa_family.action_afa_family" model="ir.actions.act_window">
        <field name="search_view_id" ref="afa_membership.view_afa_family_membership_search"/>
    </record>
    <menuitem id="menu_afa_membership_period" name="School Years"
              parent="afa_family.menu_afa_family_configuration" action="action_afa_membership_period"
              groups="afa_family.group_family_manager" sequence="30"/>
    <menuitem id="menu_afa_membership" name="Family Period Links"
              parent="afa_family.menu_afa_family_collections" action="action_afa_membership"
              groups="afa_family.group_family_manager" sequence="10"/>
</odoo>
