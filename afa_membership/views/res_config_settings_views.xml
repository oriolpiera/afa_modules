<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_afa_membership" model="ir.ui.view">
        <field name="name">res.config.settings.afa.membership</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="AFA Membership" name="afa_membership" groups="base.group_system">
                    <block title="Membership">
                        <setting id="afa_membership_mode_setting" string="Membership Mode">
                            <field name="afa_membership_mode"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
